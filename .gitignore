# =====================================================================
# .gitignore —— 组长统一维护：排除数据/输出/临时文件
# =====================================================================

# ---------- 数据文件（大文件一律不入库）----------
data/
raw/
cleaned/
output/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ---------- 系统/IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log